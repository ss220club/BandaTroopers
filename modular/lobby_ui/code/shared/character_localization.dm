/proc/banda_translate_character_preference_text(value)
	if(isnull(value))
		return ""
	var/text_value = "[value]"
	var/list/translations = get_banda_character_preferences_translations()
	if(text_value in translations)
		return translations[text_value]

	var/list/suffix_translations = list(
		" (Camo Conforming)" = " (под камуфляж)",
		" (Camo Non-Conforming)" = " (без камуфляжа)",
		" (Classic)" = " (классический)",
		" (Jungle)" = " (джунгли)",
		" (Desert)" = " (пустыня)",
		" (Snow)" = " (снег)"
	)
	for(var/suffix in suffix_translations)
		if(length(text_value) <= length(suffix) || copytext(text_value, length(text_value) - length(suffix) + 1) != suffix)
			continue
		var/base_value = copytext(text_value, 1, length(text_value) - length(suffix) + 1)
		var/base_translation = translations[base_value] || base_value
		return "[base_translation][suffix_translations[suffix]]"

	return text_value

/datum/preferences/proc/get_banda_localized_preference_choices(list/canonical_choices)
	var/list/localized_choices = list()
	if(!islist(canonical_choices))
		return localized_choices

	for(var/canonical_choice in canonical_choices)
		if(isnull(canonical_choice))
			continue
		var/base_label = banda_translate_character_preference_text(canonical_choice)
		var/display_label = base_label
		var/duplicate_index = 2
		while(display_label in localized_choices)
			display_label = "[base_label] ([duplicate_index])"
			duplicate_index++
		localized_choices[display_label] = canonical_choice

	return localized_choices

/datum/preferences/proc/banda_localized_preference_choice(mob/user, prompt, title, list/canonical_choices)
	var/list/localized_choices = get_banda_localized_preference_choices(canonical_choices)
	var/selected_label = tgui_input_list(user, prompt, title, localized_choices, theme = "crtgreen", presentation = get_banda_tgui_input_presentation())
	if(isnull(selected_label))
		return null
	return localized_choices[selected_label]

