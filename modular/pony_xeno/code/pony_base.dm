	body_variant = other.body_variant
	mane_front_variant = other.mane_front_variant
	mane_back_variant = other.mane_back_variant
	tail_variant = other.tail_variant
	eye_variant = other.eye_variant
	horn_variant = other.horn_variant
	wing_variant = other.wing_variant
	cutie_mark_variant = other.cutie_mark_variant
	armor_variant = other.armor_variant
	body_color = other.body_color
	mane_primary_color = other.mane_primary_color
	mane_secondary_color = other.mane_secondary_color
	tail_primary_color = other.tail_primary_color
	tail_secondary_color = other.tail_secondary_color
	eye_color = other.eye_color
	armor_tint = other.armor_tint
	sprite_seed = other.sprite_seed
	return src

/datum/caste_datum/pony_xeno
	language = LANGUAGE_XENOMORPH
	evolution_allowed = FALSE
	heal_resting = 1.4
	heal_standing = 0.45
	heal_knocked_out = 0.33
	minimap_icon = "xeno"

	var/pony_minimap_body_color = "#F7C8DA"
	var/pony_minimap_eye_color = "#1E1E1E"
	var/pony_minimap_show_horn = FALSE
	var/pony_minimap_show_wings = FALSE
	var/pony_minimap_crown = FALSE

/datum/caste_datum/pony_xeno/get_minimap_icon()
	if(GLOB.pony_xeno_minimap_icons[caste_type])
		return GLOB.pony_xeno_minimap_icons[caste_type]

	var/icon/canvas = new /icon(PONY_XENO_ICON_STATES_BASE, PONY_XENO_ICON_STATE_EMPTY)
	canvas.Scale(PONY_XENO_MINIMAP_SIZE, PONY_XENO_MINIMAP_SIZE)

	var/icon/body = new /icon(PONY_XENO_ICON_BODY, "earth_pony_core", SOUTH)
	body.GrayScale()
	body.Blend(pony_minimap_body_color, ICON_MULTIPLY)
	body.Scale(PONY_XENO_MINIMAP_SIZE, PONY_XENO_MINIMAP_SIZE)
	canvas.Blend(body, ICON_OVERLAY)

	if(pony_minimap_show_wings)
		var/icon/wings = new /icon(PONY_XENO_ICON_WINGS, "m_pony_wings_pony_FRONT", SOUTH)
		wings.GrayScale()
		wings.Blend(pony_minimap_body_color, ICON_MULTIPLY)
		wings.Scale(PONY_XENO_MINIMAP_SIZE, PONY_XENO_MINIMAP_SIZE)
		canvas.Blend(wings, ICON_OVERLAY)

	if(pony_minimap_show_horn)
		var/icon/horn = new /icon(PONY_XENO_ICON_HORN, "m_pony_horn_pony_FRONT", SOUTH)
		horn.GrayScale()
		horn.Blend(pony_minimap_eye_color, ICON_MULTIPLY)
		horn.Scale(PONY_XENO_MINIMAP_SIZE, PONY_XENO_MINIMAP_SIZE)
		canvas.Blend(horn, ICON_OVERLAY)

	if(pony_minimap_crown)
		var/icon/crown = new /icon(PONY_XENO_ICON_CUTIE, "tele_effect", SOUTH)
		crown.GrayScale()
		crown.Blend("#FFD166", ICON_MULTIPLY)
		crown.Scale(PONY_XENO_MINIMAP_SIZE, PONY_XENO_MINIMAP_SIZE)
		canvas.Blend(crown, ICON_OVERLAY)

	var/image/background = mutable_appearance('icons/ui_icons/map_blips.dmi', "background")
	background.color = MINIMAP_ICON_BACKGROUND_XENO
	background.overlays += image(icon = canvas)
	GLOB.pony_xeno_minimap_icons[caste_type] = background
	return background
