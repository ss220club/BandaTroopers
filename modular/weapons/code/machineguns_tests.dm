#if defined(UNIT_TESTS) || defined(SPACEMAN_DMM)
/datum/unit_test/machineguns/Run()
	var/turf/test_turf = locate(1, 1, 1)
	var/obj/item/weapon/gun/mg42/mg42 = new(test_turf)
	var/obj/item/weapon/gun/mg3/mg3 = new(test_turf)
	var/obj/item/ammo_box/rounds/mg42/mg42_box = new(test_turf)
	var/obj/item/ammo_box/rounds/mg3/mg3_box = new(test_turf)
	var/obj/item/ammo_box/magazine/mg42/mg42_belts = new(test_turf)
	var/obj/item/ammo_box/magazine/mg3/mg3_belts = new(test_turf)
	var/list/guns = list(mg42, mg3)
	var/list/boxes = list(mg42_box, mg3_box)
	var/list/belt_boxes = list(mg42_belts, mg3_belts)
	for(var/i in 1 to 2)
		var/obj/item/weapon/gun/gun = guns[i]
		var/obj/item/ammo_box/rounds/box = boxes[i]
		var/obj/item/ammo_box/magazine/belt_box = belt_boxes[i]
		if(!gun.current_mag || gun.current_mag.current_rounds <= 0)
			return Fail("[gun.type] spawns without ammunition", __FILE__, __LINE__)
		if(gun.current_mag.default_ammo != box.default_ammo || gun.current_mag.caliber != box.caliber)
			return Fail("[gun.type] cannot use its ammunition box", __FILE__, __LINE__)
		if(length(belt_box.contents) != 8)
			return Fail("[gun.type] belt box has the wrong magazine count", __FILE__, __LINE__)
		for(var/obj/item/ammo_magazine/magazine in belt_box.contents)
			if(magazine.type != gun.current_mag.type || magazine.default_ammo != box.default_ammo || magazine.caliber != box.caliber)
				return Fail("[gun.type] belt box contains incompatible ammunition", __FILE__, __LINE__)
		if(!(gun.icon_state in icon_states(gun.icon)) || !("[gun.icon_state]_e" in icon_states(gun.icon)))
			return Fail("[gun.type] lacks a world sprite", __FILE__, __LINE__)
		for(var/slot in list(WEAR_L_HAND, WEAR_R_HAND, WEAR_BACK))
			if(!(gun.get_icon_state(null, slot) in icon_states(gun.item_icons[slot])))
				return Fail("[gun.type] lacks a worn sprite for [slot]", __FILE__, __LINE__)
		if(!(gun.current_mag.icon_state in icon_states(gun.current_mag.icon)))
			return Fail("[gun.type] lacks a belt sprite", __FILE__, __LINE__)
		if(!(box.icon_state in icon_states(box.icon)))
			return Fail("[gun.type] lacks an ammunition box sprite", __FILE__, __LINE__)
		if(!(belt_box.icon_state in icon_states(belt_box.icon)) || !("[belt_box.icon_state]_lid" in icon_states(belt_box.icon)))
			return Fail("[gun.type] lacks a belt box sprite", __FILE__, __LINE__)
	if(mg3.fire_delay >= mg42.fire_delay)
		return Fail("MG3 must fire faster than MG42", __FILE__, __LINE__)
	if(mg42.firesound_volume <= mg3.firesound_volume || mg42.firesound_volume > 60)
		return Fail("MG42 must sound louder than MG3 without exceeding normal gun volume", __FILE__, __LINE__)
	if(istype(mg3, mg42.current_mag.gun_type) || istype(mg42, mg3.current_mag.gun_type))
		return Fail("Machine gun ammunition families must stay separate", __FILE__, __LINE__)
	var/datum/ammo/bullet/mg42/mg42_ammo = new
	var/datum/ammo/bullet/mg3/mg3_ammo = new
	if(mg3_ammo.damage >= mg42_ammo.damage || mg3_ammo.penetration >= mg42_ammo.penetration)
		return Fail("MG3 must have lower damage and penetration", __FILE__, __LINE__)
	qdel(mg42)
	qdel(mg3)
	qdel(mg42_box)
	qdel(mg3_box)
	qdel(mg42_belts)
	qdel(mg3_belts)
	qdel(mg42_ammo)
	qdel(mg3_ammo)
#endif
